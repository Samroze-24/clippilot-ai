# ClipPilot AI — copy to .env and adjust. No API keys are required to run.
SECRET_KEY=change-this-dev-secret
DATABASE_URL=sqlite:///./clippilot.db
# Caption font (burned-in captions + hook titles). Windows default is
# C:\Windows\Fonts\arial.ttf. Leave empty to auto-detect, or point at any .ttf.
CAPTION_FONT=
# Whisper model for local transcription (downloaded once from HuggingFace, ~75 MB).
WHISPER_MODEL=tiny
# --- LLM clip selection (Groq, optional) ---
# 1. Get a free key at https://console.groq.com/keys (no card needed).
# 2. Set LLM_PROVIDER=groq and paste the key below. Never share the key or
#    commit this file — the key stays in your local .env only.
# 3. Without these, analysis uses the local transparent scorer instead.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1
# --- Direct YouTube publishing (optional) ---
# 1. Google Cloud Console -> new project -> enable YouTube Data API v3.
# 2. OAuth consent screen (External, test users: your own Google account).
# 3. Credentials -> Create OAuth client ID (Desktop app) -> add redirect URI:
#    http://127.0.0.1:8012/api/publish/youtube/callback
# 4. Paste the client ID + secret below, restart, then click Connect YouTube
#    on the Publishing tab. Tokens are stored locally in data/youtube_token.json
#    (gitignored, never uploaded). Uploads default to private.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://127.0.0.1:8012/api/publish/youtube/callback
# --- Transcription provider (optional) ---
# Default is local faster-whisper (offline, no key). To use AssemblyAI
# cloud transcription instead, get a free key at https://www.assemblyai.com/
# and set both lines below. With provider=assemblyai and no key,
# transcription fails closed with a clear error (never a fake transcript).
TRANSCRIPTION_PROVIDER=local
ASSEMBLYAI_API_KEY=
# --- Pexels stock B-roll (optional) ---
# Get a free API key at https://www.pexels.com/api/ (no card). Without it,
# the Pexels search/download endpoints return 503 "Not configured" and the
# local B-roll upload slot is used instead.
PEXELS_API_KEY=
# --- Twitch channel VOD import (optional) ---
# Create an app at https://dev.twitch.tv/console/apps and paste its client
# ID + secret below. Without them, the Twitch VOD endpoints return 503
# "Not configured". Live streams are never imported (only finished VODs).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# --- Direct TikTok publishing (optional) ---
# Register an app at developers.tiktok.com and request the video.upload
# scope (TikTok approval required). Then paste the client key + secret
# below, restart, and click Connect TikTok on the Publishing tab. Uploads
# default to SELF_ONLY (only you can see them).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8012/api/publish/tiktok/callback
# --- Direct Instagram publishing (optional) ---
# Create a Meta developer app, add the Instagram Graph API product, connect
# a Business/Creator account, and create a long-lived user access token.
# INSTAGRAM_VIDEO_BASE_URL is REQUIRED for publishing: Instagram downloads
# the video from a PUBLIC https URL, so point it at a public host that
# serves your clip files (localhost will not work).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_VIDEO_BASE_URL=
