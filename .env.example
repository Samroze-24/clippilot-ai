# ClipPilot AI — copy to .env and adjust. No API keys are required to run.
SECRET_KEY=change-this-dev-secret
DATABASE_URL=sqlite:///./clippilot.db
# Caption font (burned-in captions + hook titles). Windows default is
# C:\Windows\Fonts\arial.ttf. Leave empty to auto-detect, or point at any .ttf.
CAPTION_FONT=
# Whisper model for local transcription (downloaded once from HuggingFace, ~75 MB).
WHISPER_MODEL=tiny
# Optional later steps (all "Not configured" until set — never required):
# ASSEMBLYAI_API_KEY=
# LLM_API_KEY=
# PEXELS_API_KEY=
